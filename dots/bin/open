#!/usr/bin/env bash
# macOS-style `open` for Linux hosts; linked at ~/.local/bin/open on Linux only.
set -euo pipefail

if [ "$(uname -s)" = "Darwin" ]; then
  exec /usr/bin/open "$@"
fi

if [ "$#" -eq 0 ]; then
  echo "usage: open <file|url> [...]" >&2
  exit 1
fi

for arg in "$@"; do
  xdg-open "$arg"
done
