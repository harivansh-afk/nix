# Main git config, linked at ~/.config/git/config. Live-edited.
# Machine-generated companions in the same directory:
#   credentials.inc - forgejo credential helpers; on spark also rewrites
#                     git.harivan.sh to loopback SSH (skips the CF tunnel)

[user]
	name = Harivansh Rathi
	email = rathiharivansh@gmail.com
	signingKey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgSign = true

[tag]
	gpgSign = true

[advice]
	detachedHead = false

[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore

[feature]
	manyFiles = true

[push]
	autoSetupRemote = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[include]
	path = ~/.config/git/credentials.inc
