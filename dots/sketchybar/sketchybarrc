#!/bin/bash
# Layout only; sketchybar-feed supplies values and workspace visibility.
source "$CONFIG_DIR/themes/current"

FONT="SF Pro"
PAD=14
SECTION_WIDTH=240
NOTCH_HEIGHT="$(notch-inset 2>/dev/null)"
case "$NOTCH_HEIGHT" in '' | *[!0-9]* | 0) NOTCH_HEIGHT=43 ;; esac

sketchybar --bar \
  position=top display=main sticky=on \
  height=32 notch_display_height="$NOTCH_HEIGHT" \
  color="$BAR_COLOR" border_width=0 corner_radius=0 \
  margin=0 y_offset=0 padding_left=0 padding_right=0 \
  shadow=off font_smoothing=on

sketchybar --default \
  padding_left=0 padding_right=0 \
  background.drawing=off background.color="$BAR_COLOR" \
  background.height=0 background.corner_radius=0 \
  background.border_width=0 background.border_color="$BORDER_COLOR" \
  icon.drawing=on icon.font="$FONT:Regular:18.0" \
  icon.color="$TEXT_COLOR" icon.padding_left=$PAD icon.padding_right=4 \
  label.font="$FONT:Regular:18.0" label.color="$TEXT_COLOR" \
  label.padding_left=4 label.padding_right=$PAD

# Height zero follows the actual bar height, including the notch area.
block() {
  sketchybar --set "$1" background.drawing=on \
    background.height=0 background.corner_radius=0 \
    background.border_width=1 background.border_color="$BORDER_COLOR"
}

# AeroSpace and the feed start alongside SketchyBar at login.
for _ in $(seq 1 60); do
  aerospace list-workspaces --all >/dev/null 2>&1 && break
  sleep 0.5
done

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item "space.$sid" left --set "space.$sid" \
    drawing=off width=80 \
    icon="$sid" icon.padding_right=9 \
    label.font="sketchybar-app-font:Regular:20.0" \
    label.drawing=off label.padding_left=0 \
    click_script="aerospace workspace $sid"
  block "space.$sid"
done

# Rightmost first: three equally wide sections with matching 14pt insets.
sketchybar --add item clock right --set clock \
  width=$SECTION_WIDTH \
  click_script="open -a Calendar"

sketchybar --add item battery right --set battery \
  width=$((SECTION_WIDTH / 2)) icon=bat label.font="$FONT:Bold:18.0" \
  click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"'

sketchybar --add item volume right --set volume \
  width=$((SECTION_WIDTH / 2)) icon=vol \
  script="sketchybar-feed volume-event" \
  --subscribe volume mouse.clicked mouse.scrolled

sketchybar --add item resources right --set resources \
  width=$SECTION_WIDTH icon.padding_right=9 label.padding_left=9

sketchybar --add bracket section.resources resources \
  --add bracket section.settings volume battery \
  --add bracket section.date clock
for section in resources settings date; do
  block "section.$section"
done

sketchybar --update
pkill -USR1 -x sketchybar-feed || true
