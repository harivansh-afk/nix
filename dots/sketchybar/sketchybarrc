#!/bin/bash
# SketchyBar rc, linked at ~/.config/sketchybar/sketchybarrc. Cozybox
# floating layout: the bar itself is fully transparent (no painted strip),
# only the items carry a background - soft rounded blocks, no borders.
# Left: one floating tab per aerospace workspace (number + one app icon
# glyph, focused tab in the accent). Right: floating resource and status blocks.
# The notch keeps the two sections apart; nothing is placed in the middle.
# Colors come from themes/current, a symlink managed by the `theme` script
# (rendered per-mode from lib/theme.nix).

source "$CONFIG_DIR/themes/current"

PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="Berkeley Mono"
APP_FONT="sketchybar-app-font"

# One text size across the whole bar - user preference (grew from 13pt via
# 14pt to 18pt). The app glyph font keeps its historical +2pt over the text
# size (sketchybar-app-font renders visually smaller at equal pt).
FONT_SIZE=18.0
APP_FONT_SIZE=20.0

# Height of the notch strip: NSScreen.safeAreaInsets.top. It is a POINT value
# that changes with the scaled resolution (43 @ 2048x1330, 49 @ 2294x1490), so
# it is measured at rc time instead of hardcoded - a stale constant misaligns
# every margin. Max across screens, via `notch-inset`: a tiny AppKit binary
# compiled by nix (hosts/macbook/notch-inset, on the agent PATH through
# services.sketchybar.extraPackages), ~10ms. This used to be `swift -e`, which
# JIT-compiles through xcodebuild: at a cold login it blocked this rc for
# minutes (2026-08-18: swift-frontend still running 5 min in) so nothing below
# ever ran and the bar came up empty at default geometry. Never call swift
# here. Falls back to 43 (the historical built-in value) if no screen reports
# an inset or the helper is missing.
BAR_HEIGHT="$(notch-inset 2>/dev/null)"
case "$BAR_HEIGHT" in '' | *[!0-9]* | 0) BAR_HEIGHT=43 ;; esac

# Strip-relative sizes scale from their 43pt-baseline calibrations (rounded)
# so proportions hold at every resolution. Text sizes and the PAD_* scale stay
# absolute: fonts are a user preference in fixed points.
scale() { echo $((($1 * BAR_HEIGHT + 21) / 43)); }

# MARGIN is the air around the floating blocks: the item height and the bar
# edge padding both derive from it so the gap is identical top, bottom, left
# and right. 6 @ 43.
MARGIN=$(scale 6)
ITEM_HEIGHT=$((BAR_HEIGHT - 2 * MARGIN))

# calibrated by eye against the physical display corner curve at 43pt (Apple
# does not publish the radius and no API exposes it on macOS); scales with
# points-per-physical-mm like everything else. 13 @ 43.
CORNER_RADIUS=$(scale 13)

# --- spacing scale (pt): every gap in the bar derives from these ---
# PAD_EDGE   inside a block at its outer edges (also glyphless-tab padding,
#            mirrored in plugins/spaces.sh - keep them in sync)
# PAD_ITEM   each side of a component boundary in the right block (gap = 2x)
# PAD_TIGHT  between a muted prefix (vol/bat) and its value (gap = 2x)
# TAB_GAP    between workspace tabs
PAD_EDGE=14
PAD_ITEM=9
PAD_TIGHT=4
TAB_GAP=6

sketchybar --bar \
  position=top \
  height=$BAR_HEIGHT \
  color=0x00000000 \
  corner_radius=0 \
  margin=0 \
  y_offset=0 \
  padding_left=$MARGIN \
  padding_right=$MARGIN \
  display=all \
  sticky=on

# Tabs paint the main cozybox background (BAR_COLOR, #101010 dark), matching
# the ghostty terminal background - user preference. The right section paints
# no background at all (plain text on the wallpaper).
sketchybar --default \
  background.drawing=off \
  background.color="$BAR_COLOR" \
  background.corner_radius=$CORNER_RADIUS \
  background.height=$ITEM_HEIGHT \
  background.border_width=0 \
  icon.drawing=off \
  icon.font="$FONT:Regular:$FONT_SIZE" \
  icon.color="$MUTED_COLOR" \
  icon.padding_left=$PAD_ITEM \
  icon.padding_right=$PAD_TIGHT \
  label.font="$FONT:Regular:$FONT_SIZE" \
  label.color="$TEXT_COLOR" \
  label.padding_left=$PAD_TIGHT \
  label.padding_right=$PAD_ITEM

# --- left section: floating workspace tabs ---
# Static shells only; plugins/spaces.sh renders all of them in one batch per
# event (one process per event instead of one per workspace - keeps it fast).
sketchybar --add event aerospace_workspace_change

# aerospace and sketchybar are sibling launchd agents started together at
# login; without a server `list-workspaces` prints nothing and the loop would
# build zero tabs. Wait (bounded, 30s) for readiness - bar geometry above is
# already applied, so nothing visible is delayed.
for _ in $(seq 1 60); do
  aerospace list-workspaces --all >/dev/null 2>&1 && break
  sleep 0.5
done

for sid in $(aerospace list-workspaces --all); do
  # tab internals are visually compensated for font side bearings (digits
  # render ~2pt inside their advance, the app glyphs ~1pt): 10/11/10 makes
  # all three gaps measure ~12pt on screen (verified by pixel measurement);
  # plugins/spaces.sh mirrors these numbers - keep them in sync
  sketchybar --add item "space.$sid" left \
    --set "space.$sid" \
    drawing=off \
    background.drawing=on \
    padding_left=0 \
    padding_right=$TAB_GAP \
    icon.drawing=on \
    icon="$sid" \
    icon.padding_left=10 \
    icon.padding_right=11 \
    label.font="$APP_FONT:Regular:$APP_FONT_SIZE" \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=10 \
    click_script="aerospace workspace $sid"
done

sketchybar --add item spaces_monitor left \
  --subscribe spaces_monitor aerospace_workspace_change front_app_switched system_woke \
  --set spaces_monitor \
  drawing=off \
  script="$PLUGIN_DIR/spaces.sh"

# --- right section: one floating block, spacing instead of separators:
# volume | battery | clock ---
# (items added rightmost-first, grouped by a bracket that paints the
# shared background)
# icon = date (normal text color), label = time (pink)
# background.drawing=off is set explicitly on every right item: properties
# persist in the daemon across --reload, so relying on the default would
# leave a stale painted block behind after a config change.
sketchybar --add item clock right \
  --subscribe clock system_woke \
  --set clock \
  background.drawing=off \
  update_freq=10 \
  icon.drawing=on \
  icon.font="$FONT:Regular:$FONT_SIZE" \
  icon.color="$TEXT_COLOR" \
  icon.padding_left=$PAD_ITEM \
  icon.padding_right=$PAD_TIGHT \
  label.font="$FONT:Regular:$FONT_SIZE" \
  label.color="$PINK_COLOR" \
  label.padding_left=$PAD_TIGHT \
  label.padding_right=$PAD_EDGE \
  click_script="open -a Calendar" \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
  background.drawing=off \
  update_freq=60 \
  icon.drawing=on \
  icon=bat \
  icon.font="$FONT:Regular:$FONT_SIZE" \
  icon.padding_left=$PAD_ITEM \
  icon.padding_right=$PAD_TIGHT \
  label.font="$FONT:Bold:$FONT_SIZE" \
  label.padding_left=$PAD_TIGHT \
  label.padding_right=$PAD_ITEM \
  click_script='open "x-apple.systempreferences:com.apple.Battery-Settings.extension"' \
  script="$PLUGIN_DIR/battery.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change mouse.clicked mouse.scrolled \
  --set volume \
  background.drawing=off \
  icon.drawing=on \
  icon=vol \
  icon.font="$FONT:Regular:$FONT_SIZE" \
  icon.padding_left=$PAD_EDGE \
  icon.padding_right=$PAD_TIGHT \
  label.font="$FONT:Regular:$FONT_SIZE" \
  label.padding_left=$PAD_TIGHT \
  label.padding_right=$PAD_ITEM \
  script="$PLUGIN_DIR/volume.sh"

# No bracket/background on the right section: the items sit directly on the
# wallpaper - user preference.

# --- resources: immediately left of the status items ---
sketchybar --add item resources right \
  --set resources \
  background.drawing=off \
  update_freq=5 \
  padding_right=$TAB_GAP \
  icon.drawing=on \
  icon.font="$FONT:Regular:$FONT_SIZE" \
  icon.padding_left=$PAD_EDGE \
  icon.padding_right=$PAD_ITEM \
  label.font="$FONT:Regular:$FONT_SIZE" \
  label.padding_left=$PAD_ITEM \
  label.padding_right=$PAD_EDGE \
  script="$PLUGIN_DIR/stats.sh"

# --- resolution watchdog ---
# A resolution change moves safeAreaInsets.top but sketchybar fires no event
# for it: this hidden item polls the daemon's own display frames (one ~ms
# socket query per tick, no swift) and reloads the config - which re-measures
# BAR_HEIGHT - when they drift from the stamp of the last load.
sketchybar --add item display_monitor left \
  --subscribe display_monitor display_change system_woke \
  --set display_monitor \
  drawing=off \
  update_freq=10 \
  script="$PLUGIN_DIR/display.sh"

# --- init ---
sketchybar --update
sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
