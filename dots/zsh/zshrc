if [[ "$TERM_PROGRAM" == rex ]]; then
  export TERM=xterm-ghostty
  if [[ -z "$REX_LOCAL" ]] && (( $+commands[rex-spark] )); then
    trap 'muxd close "spark:rex-$REX_BLOCK" &>/dev/null' HUP
    rex-spark
    exit
  fi
fi
if [[ "$TERM" == xterm-ghostty && "$TERM_PROGRAM" != ghostty ]]; then
  for _ghostty_zsh in \
    "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" \
    "$GHOSTTY_SHELL_INTEGRATION_DIR/zsh/ghostty-integration"; do
    if [[ -r "$_ghostty_zsh" ]]; then
      source "$_ghostty_zsh"
      break
    fi
  done
  unset _ghostty_zsh
fi

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh_history"
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt EXTENDED_HISTORY
setopt APPEND_HISTORY

bindkey -v

autoload -U compinit && compinit -d "${XDG_STATE_HOME:-$HOME/.local/state}/zcompdump" -u
zmodload zsh/complist
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-za-z}'

alias cc="ANTHROPIC_MODEL=claude-opus-5-5 cc-proxy"
alias co="codex -c model_reasoning_effort=low"
alias com="codex -c model_reasoning_effort=high"
alias coh="codex -c model_reasoning_effort=high"
alias cl="clear"
alias gc="git commit"
alias gd="git diff"
alias gk="git checkout"
alias gp="git push"
alias gpo="git pull origin"
alias gs="git status"
alias ld="lumen diff"
alias nv="nvim ."
alias vi="nvim"
alias vim="nvim"
alias vimdiff="nvim -d"
alias eza="eza --icons=auto --git --group-directories-first --header"
alias ls="eza"
alias ll="eza -l"
alias la="eza -a"
alias lt="eza --tree"
alias lla="eza -la"

if [[ "$OSTYPE" == darwin* ]]; then
  alias vnc-spark="/usr/bin/open vnc://spark:45931"
  alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi

eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"
export DIRENV_LOG_FORMAT=""
if [[ $options[zle] = on ]] && command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

if [[ -f ~/.config/secrets/shell.zsh ]]; then
  source ~/.config/secrets/shell.zsh
elif [[ -f ~/.secrets ]]; then
  source ~/.secrets
fi

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

export BUN_INSTALL="$HOME/.bun"
npm_global_prefix="$(npm prefix -g 2>/dev/null)"
typeset -U path PATH
path=(
  "$HOME/.amp/bin"
  "$BUN_INSTALL/bin"
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/.opencode/bin"
  ${npm_global_prefix:+"$npm_global_prefix/bin"}
  "$HOME/.nix-profile/bin"
  "/run/wrappers/bin"
  "/etc/profiles/per-user/$USER/bin"
  "/run/current-system/sw/bin"
  "/nix/var/nix/profiles/default/bin"
  $path
)
unset npm_global_prefix
if [[ -d /opt/homebrew/bin ]]; then
  path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
fi

[[ -x /run/current-system/sw/bin/aerospace ]] &&
  export AEROSPACE_BIN=/run/current-system/sw/bin/aerospace

_codex_read_theme_mode() {
  local mode_file="$HOME/.local/state/theme/current"
  if [[ -f "$mode_file" ]]; then
    local mode
    mode=$(tr -d '[:space:]' <"$mode_file")
    if [[ "$mode" == light || "$mode" == dark ]]; then
      printf '%s' "$mode"
      return
    fi
  fi
  printf 'dark'
}

_codex_source_theme_file() {
  local mode="$1"
  local theme_file="$HOME/.config/zsh/themes/$mode.zsh"
  [[ -f "$theme_file" ]] && source "$theme_file"
}

_codex_apply_highlight_styles() {
  local mode="$(_codex_read_theme_mode)"
  [[ "$mode" == "${_CODEX_LAST_HIGHLIGHT_THEME:-}" ]] && return

  typeset -gA ZSH_HIGHLIGHT_STYLES
  _codex_source_theme_file "$mode"
  typeset -g _CODEX_LAST_HIGHLIGHT_THEME="$mode"
}

_codex_apply_bat_theme() {
  local mode="$(_codex_read_theme_mode)"
  if [[ "$mode" == light ]]; then
    export BAT_THEME='gruvbox-light'
  else
    export BAT_THEME='gruvbox-dark'
  fi
}

unalias ga 2>/dev/null

git() {
  command git "$@"
  local exit_code=$?
  case "$1" in
    add | stage | reset | checkout)
      if command -v critic >/dev/null 2>&1; then
        (critic review 2>/dev/null &)
      fi
      ;;
  esac
  return $exit_code
}

autoload -Uz add-zle-hook-widget
_codex_cursor() { printf '\e[%s q' "${1:-6}"; }
_codex_cursor_select() { [[ "$KEYMAP" == vicmd ]] && _codex_cursor 2 || _codex_cursor 6; }
_codex_cursor_beam() { _codex_cursor 6; }
add-zle-hook-widget zle-keymap-select _codex_cursor_select
add-zle-hook-widget zle-line-init _codex_cursor_beam
add-zle-hook-widget zle-line-finish _codex_cursor_beam

source "${DOTS_ZSH_DIR:-$HOME/Documents/Git/nix/dots/zsh}/prompt.zsh"

precmd() {
  _codex_apply_prompt_theme
  _codex_apply_highlight_styles
  _codex_apply_bat_theme
  _codex_cursor_beam
}
preexec() { _codex_cursor_beam; }

_codex_apply_prompt_theme
_codex_apply_highlight_styles
_codex_apply_bat_theme

bindkey '^k' forward-char
bindkey '^j' backward-char

_open_nvim() {
  if [[ -n "$BUFFER" ]]; then
    zle down-line-or-history
    return
  fi
  BUFFER="nv"
  zle accept-line
}
zle -N _open_nvim
bindkey -M viins '^N' _open_nvim
bindkey -M vicmd '^N' _open_nvim

_open_pr() {
  BUFFER="nvim +PR"
  zle accept-line
}
zle -N _open_pr
bindkey -M viins '^P' _open_pr
bindkey -M vicmd '^P' _open_pr

_open_fugitive() {
  if [[ -n "$BUFFER" ]]; then
    zle list-expand
    return
  fi
  BUFFER="nvim +Git +only"
  zle accept-line
}
zle -N _open_fugitive
bindkey -M viins '^G' _open_fugitive
bindkey -M vicmd '^G' _open_fugitive

_open_files() {
  if [[ -n "$BUFFER" ]]; then
    zle self-insert
    return
  fi
  BUFFER="nvim +'Pick files'"
  zle accept-line
}
zle -N _open_files
bindkey -M viins '^F' _open_files
bindkey -M vicmd '^F' _open_files
