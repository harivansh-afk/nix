#!/bin/sh
# herdr plugin glue: every space is an ix VM. Workspaces created by the `new`
# action carry IX_SPACE_VM / IX_SPACE_TEMPLATE as workspace env, which every
# pane of that workspace inherits; `boot` and `enter` run inside panes and
# compose released ix primitives (new / ls / shell / migrate) only.
set -eu

template() {
    if [ -n "${IX_SPACE_TEMPLATE:-}" ]; then
        printf %s "$IX_SPACE_TEMPLATE"
    elif [ -r "${HERDR_PLUGIN_CONFIG_DIR:-/nonexistent}/template" ]; then
        cat "$HERDR_PLUGIN_CONFIG_DIR/template"
    else
        printf %s "github:harivansh-afk/nix#ix"
    fi
}

# Plugin action: create the workspace immediately (labeled after its VM, so
# the sidebar reads as a VM list), then boot the VM inside the first pane so
# the create progress is visible where the shell will appear.
new() {
    vm="space-$(od -An -N4 -tx4 /dev/urandom | tr -d ' \n')"
    tpl="$(template)"
    h="${HERDR_BIN_PATH:-herdr}"
    out="$("$h" workspace create --label "$vm" \
        --env IX_SPACE_VM="$vm" --env IX_SPACE_TEMPLATE="$tpl" --focus)"
    pane="$(printf %s "$out" | grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)"
    [ -n "$pane" ] || { echo "ix-space: no pane in workspace create reply" >&2; exit 1; }
    "$h" pane run "$pane" " exec ix-space boot"
}

# Runs inside a space's first pane: boot the VM on first use, then enter it.
boot() {
    vm="${IX_SPACE_VM:?ix-space boot runs inside a space workspace}"
    if ! ix ls --output json 2>/dev/null | grep -q "\"name\"[[:space:]]*:[[:space:]]*\"$vm\""; then
        echo "ix-space: booting $vm from ${IX_SPACE_TEMPLATE:-default}"
        # A sibling pane may be racing the same boot; the loser attaches to
        # the winner's VM.
        ix new "${IX_SPACE_TEMPLATE:-default}" -n "$vm" || true
    fi
    exec "$0" enter
}

# Runs inside any pane of a space workspace: open a shell in its VM. The
# probe + migrate handles a platform bug where guest-to-sibling shell on the
# SAME node hangs after the QUIC handshake (indexable-inc/ix#10126, finding
# 8); moving the space to another node makes the path cross-node, which
# works. Delete once the hairpin is fixed.
enter() {
    vm="${IX_SPACE_VM:?ix-space enter runs inside a space workspace}"
    echo "ix-space: checking the shell path to $vm (up to 12s)"
    rc=0
    timeout 12 ix shell "$vm" --noninteractive -- true >/dev/null 2>&1 || rc=$?
    if [ "$rc" = 124 ]; then
        echo "ix-space: shell path wedged (same-node placement); migrating $vm - about 40s, once"
        ix migrate "$vm" || true
    fi
    exec ix shell "$vm"
}

# Plugin pane: live VM table.
vms() {
    while :; do
        printf '\033[2J\033[H'
        ix ls 2>&1 || true
        sleep 5
    done
}

case "${1:-}" in
    new) new ;;
    boot) boot ;;
    enter) enter ;;
    vms) vms ;;
    *)
        echo "usage: ix-space new|boot|enter|vms" >&2
        exit 64
        ;;
esac
