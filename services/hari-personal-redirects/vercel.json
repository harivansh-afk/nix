{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/",
      "status": 308,
      "headers": {
        "Location": "https://harivan.sh"
      }
    },
    {
      "src": "/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://harivan.sh/"
      }
    }
  ]
}
